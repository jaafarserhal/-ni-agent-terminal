{
  "name": "ni-agent-terminal",
  "productName": "NI Agent Terminal",
  "version": "1.2.1",
  "description": "Multi-tab terminal for Claude Code, Codex, Cursor Agent and OpenCode, on Windows or WSL, with per-folder, per-agent session history.",
  "main": "src/main.js",
  "author": "NI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "shortcut": "electron . --install-shortcut",
    "test": "python -m unittest discover -s test",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/history.js && node --check src/agents.js && node --check src/sessions.js && node --check src/backend.js && node --check src/engine.js && node --check src/renderer.js",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ni.agentterminal",
    "productName": "NI Agent Terminal",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "!**/__pycache__/**", "package.json"],
    "asarUnpack": ["node_modules/node-pty/**", "src/py/**"],
    "npmRebuild": false,
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.png"
    },
    "portable": { "artifactName": "NI-Agent-Terminal-${version}-portable.exe" },
    "nsis": {
      "artifactName": "NI-Agent-Terminal-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

